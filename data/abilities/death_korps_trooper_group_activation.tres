[ext_resource type="Script" path="res://core/resources/ability_data.gd" id="1"]

[resource]
script = ExtResource("1")
ability_id = "death_korps_trooper_group_activation"
display_name = "Group Activation"
description = "Whenever this operative is expended, activate one other ready friendly DEATH KORPS TROOPER operative (if able) before the opponent activates. When that operative is expended, the opponent activates as normal -- at most two operatives in succession from this rule."
effects = Array[Resource]([])
unique_procedural = true
